<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/detail_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/background"
        app:titleTextColor="@color/text_primary"
        app:navigationIcon="@drawable/ic_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/detail_image"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@drawable/bg_image_rounded"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:contentDescription="عکس بازی" />

            <!-- تنظیمات بهینه سبز -->
            <LinearLayout
                android:id="@+id/green_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp">

                <TextView
                    style="@style/TagChip"
                    android:background="@drawable/bg_tag_green"
                    android:text="@string/green_settings"
                    android:textColor="@color/tag_green" />

                <TextView
                    android:id="@+id/detail_settings_green"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:lineSpacingExtra="6dp"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary" />

            </LinearLayout>

            <!-- تنظیمات بهینه زرد -->
            <LinearLayout
                android:id="@+id/yellow_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <TextView
                    style="@style/TagChip"
                    android:background="@drawable/bg_tag_yellow"
                    android:text="@string/yellow_settings"
                    android:textColor="@color/tag_yellow" />

                <TextView
                    android:id="@+id/detail_settings_yellow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:lineSpacingExtra="6dp"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary" />

            </LinearLayout>

            <!-- تنظیمات فریم جنریشن -->
            <LinearLayout
                android:id="@+id/framegen_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <TextView
                    style="@style/TagChip"
                    android:background="@drawable/bg_tag_blue"
                    android:text="@string/frame_gen_settings"
                    android:textColor="@color/tag_blue" />

                <TextView
                    android:id="@+id/detail_settings_framegen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:lineSpacingExtra="6dp"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
